# Copy this file to .env and fill it in locally. Never commit .env.
GARMIN_EMAIL=your-garmin-email
GARMIN_PASSWORD=your-garmin-password
TG_BOT_TOKEN=your-telegram-bot-token
TG_CHAT_ID=your-telegram-chat-id
GARMIN_TIMEZONE=Etc/UTC
NIGHT_START_HOUR=18
DIP_BASELINE_MINUTES=10
DIP_LEAD_MINUTES=10
DIP_FOLLOW_MINUTES=5
WAKE_WINDOW_MINUTES=10
BODY_BATTERY_MAX_AGE_MINUTES=120

# Optional Gemini integration. Leave blank to disable AI replies/reviews.
GEMINI_API_KEY=
